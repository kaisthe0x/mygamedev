[gd_scene load_steps=4 format=3]

; Redere Frisbee special -- the thrown shield, a Projectile fired forward on the release frame. Its
; damage/knockback come from the Action's `hit` (injected at spawn by the director), so the Hitbox
; numbers here are just fallbacks. Placeholder disc texture (blast1) -- swap it for the real shield-throw
; art later. Straight shot for now; make it homing/returning by bumping `homing` or a return tween.

[ext_resource type="Script" path="res://scripts/combat/projectile.gd" id="1_proj"]
[ext_resource type="Script" path="res://scripts/combat/hitbox.gd" id="2_hb"]
[ext_resource type="Texture2D" path="res://vfx/shared/textures/blast1.png" id="3_tex"]

[sub_resource type="RectangleShape2D" id="shape_disc"]
size = Vector2(30, 30)

[node name="Frisbee" type="Node2D"]
script = ExtResource("1_proj")
speed = 520.0
homing = 0.0
max_range = 540.0

[node name="Disc" type="Sprite2D" parent="."]
texture = ExtResource("3_tex")
self_modulate = Color(1.6, 0.3, 0.25, 1)

[node name="Hitbox" type="Area2D" parent="."]
collision_layer = 32
collision_mask = 16
script = ExtResource("2_hb")
damage = 30.0
knockback = 120.0

[node name="Shape" type="CollisionShape2D" parent="Hitbox"]
shape = SubResource("shape_disc")
